<UserControl x:Class="ExcelAddInTest.SpeechPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExcelAddInTest"
             mc:Ignorable="d" Height="3036" Width="4486">

    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Voice Recognition" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <RichTextBox x:Name="speechBox" Height="250" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="startButton" Content="Start" Width="80" Margin="5"/>
                <Button x:Name="stopButton" Content="Stop" Width="80" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
